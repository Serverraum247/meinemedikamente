{
  "name": "MeineMedikamente",
  "version": "0.1.60",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:assemble:release": "cd android && JAVA_HOME=$(/usr/libexec/java_home -v 17) ./gradlew :app:assembleRelease",
    "android:bundle:release": "cd android && JAVA_HOME=$(/usr/libexec/java_home -v 17) ./gradlew :app:bundleRelease",
    "android:bundle:play": "cd android && JAVA_HOME=$(/usr/libexec/java_home -v 17) ./gradlew :app:bundleRelease -PrequireReleaseSigning=true",
    "e2e": "bash scripts/run-maestro-flows.sh",
    "e2e:android": "bash scripts/run-maestro-flows.sh .maestro/smoke.yaml .maestro/add-medication.yaml .maestro/add-liquid-medication.yaml .maestro/weekday-plan.yaml .maestro/free-premium-gating.yaml .maestro/premium-advanced-unit.yaml",
    "e2e:doctor": "bash scripts/check-e2e-env.sh",
    "e2e:ios": "npm run e2e:ios:xctest",
    "e2e:ios:maestro": "bash scripts/run-ios-maestro-smoke.sh",
    "e2e:ios:xctest": "bash scripts/run-ios-xctest.sh",
    "ios": "react-native run-ios",
    "lint": "npm run typecheck && npm run static:quality",
    "play:check": "node scripts/check-google-play-api.js",
    "postinstall": "bash scripts/postinstall.sh",
    "start": "react-native start",
    "static:quality": "bash scripts/check-static-quality.sh",
    "test": "jest",
    "typecheck": "tsc --noEmit --pretty false --skipLibCheck",
    "verify": "npm run lint && npm run typecheck && npm test -- --runInBand --forceExit",
    "verify:prod": "npm run e2e:doctor && npm run typecheck && npm test -- --runInBand --forceExit",
    "doctor:build": "bash scripts/doctor-build-env.sh",
    "ios:pods": "bash scripts/pod-install-ios.sh",
    "rn:config:check": "bash scripts/doctor-build-env.sh",
    "device-transfer:from-db": "node scripts/create-device-transfer-package-from-db.js",
    "device-transfer:from-db:test": "bash scripts/create-device-transfer-package-from-db.test.sh",
    "android:variants:check": "bash scripts/check-android-installed-variants.sh --mode check",
    "android:variants:clean": "bash scripts/check-android-installed-variants.sh --mode clean-internal --allow-missing-keep",
    "android:variants:test": "bash scripts/check-android-installed-variants.test.sh",
    "android:internal:build": "bash scripts/build-android-internal.sh",
    "ios:internal:build": "bash scripts/build-ios-internal.sh",
    "deploy:devices": "bash scripts/deploy-connected-devices.sh"
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-firebase/auth": "^24.0.0",
    "@react-native-firebase/firestore": "^24.0.0",
    "@react-native/new-app-screen": "0.85.2",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.12",
    "@types/crypto-js": "^4.2.2",
    "crypto-js": "^4.2.0",
    "react": "19.2.3",
    "react-native": "0.85.2",
    "react-native-calendar-events": "^2.2.0",
    "react-native-camera-kit": "^17.0.1",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.24.0",
    "react-native-sqlite-storage": "^6.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^20.1.3",
    "@react-native-community/cli-platform-android": "^20.1.3",
    "@react-native-community/cli-platform-ios": "^20.1.3",
    "@react-native/babel-preset": "0.85.2",
    "@react-native/eslint-config": "0.85.2",
    "@react-native/jest-preset": "0.85.2",
    "@react-native/metro-config": "0.85.2",
    "@react-native/typescript-config": "0.85.2",
    "@types/jest": "^29.5.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.0",
    "@types/react-native-sqlite-storage": "^6.0.5",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "optionalDependencies": {
    "react-native-iap": "^15.2.3"
  }
}
